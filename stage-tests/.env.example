# Copy to .env (git-ignored) and fill in stage values.

KYC_BASE_URL=https://kyc-stage.example.internal
KYC_API_KEY=

# msisdn with no KYC history at all (never identified/personified)
KYC_TEST_FRESH_MSISDN=

# settled client: identified + personified, and the deviceId they identified with
KYC_TEST_IDENTIFIED_MSISDN=
KYC_TEST_IDENTIFIED_DEVICE_ID=

# full anketa JSON for destructive IDENTIFY submissions (see client-data.example.json)
KYC_TEST_CLIENT_DATA_FILE=
