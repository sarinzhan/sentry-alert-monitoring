# Copy to .env next to docker-compose.yml and fill in. .env is gitignored — never commit it.
# docker-compose.yml loads this whole file via `env_file`.
# IMPORTANT: no inline comments — put comments on their own line. With env_file,
# anything after `=` (including "# ...") becomes part of the value.

# --- required ---
TELEGRAM_BOT_TOKEN=
# There is NO default chat. Alerts are opt-in per chat: add the bot to a chat/topic
# and run /subscribe <project|all> there. See the README "Subscriptions" section.
# Internal Integration Client Secret (leave empty to disable the signature check)
SENTRY_CLIENT_SECRET=

# --- app ---
DB_PATH=data/state.db
# Web UI login: accounts live in the DB (seeded with admin/admin on first run —
# change that password on the users screen). Session cookie lifetime in hours.
AUTH_SESSION_HOURS=168
# Daily per-user quota on the shared Claude token: analyses count and total
# tokens (in+out). Past either limit the user is asked to save a personal
# Claude token (their runs don't count). Semantics: >0 = cap, 0 = shared
# token FORBIDDEN, -1 = unlimited. These are only DEFAULTS — the admin edits
# the effective limits on the web settings screen.
LLM_DAILY_LIMIT=10
LLM_DAILY_TOKENS=-1
# Models offered in the web UI selector (ANTHROPIC_MODEL is the default one).
# claude-fable-5 is the newest/most capable tier; remove it if your
# token/plan has no access to it (the API would reject those runs).
# WEB_LLM_MODELS=claude-fable-5,claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5-20251001
# The three occurrence counts shown on line 2, e.g. 2343/43/22 (12h/6h/10m).
# Counted from our own event_log. Values in MINUTES: "720,360,10" = 12h/6h/10m.
STAT_WINDOWS=720,360,10

# NOTE: the values below are DEFAULTS. Any chat can override its own trigger rules,
# statuses and stat windows at runtime with /set and /alerts (see README, /help).
# Subscriptions are per chat and opt-in: /subscribe <project|all>, /alerts, /params.

# --- alert triggers ---
# ongoing reminder: min gap (hours) between alerts for the same issue
WINDOW_INTERVAL_FROM_LAST_ALERT_IN_HOUR=12
# critical: within this window (minutes), > THRESHOLD errors OR >= USERS distinct users
WINDOW_CRITICAL_INTERVAL_IN_MINUTE=10
CRITICAL_ERROR_THRESHOLD=15
AFFECTED_USER_THRESHOLD=5
# critical alerts are rate-limited to once per this many hours
WINDOW_INTERVAL_FOR_CRITICAL_IN_HOUR=4

# --- keywords (force-send) ---
# keyword force-send anti-spam floor (seconds per issue); 0 = send every match
KEYWORD_MIN_INTERVAL_SEC=0
# LLM cause+fix (Claude Agent SDK). Off by default.
ENABLE_LLM=false
# Auth: EITHER an Anthropic API key ...
ANTHROPIC_API_KEY=
# ... OR a Claude subscription OAuth token (Pro/Max) from `claude setup-token`,
# valid ~1 year. If both are set, the API key wins.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-4-8
# how many LLM calls may run at once (each is a separate `claude` subprocess)
AGENT_MAX_CONCURRENCY=2
# /ai runs agentically: the LLM gets read-only GitLab tools (read_file, search,
# blame, diffs) scoped to the service's repo. Turn off to force one-shot prompts.
ENABLE_LLM_TOOLS=true
# turn ceiling for that tool loop (each turn = one model call)
AGENT_MAX_TURNS=15
# hard ceiling on the LLM reply length (cap, not target; billed per token generated)
ANTHROPIC_MAX_TOKENS=1024
# USD -> Kyrgyz som (KGS), to also show cost in сом (api-key auth only; with a
# subscription token the message shows just the token counts)
USD_KGS_RATE=89.5
# true to dump raw Sentry payloads to the log
LOG_RAW_PAYLOAD=false

# --- Telegram TLS (corporate proxy intercepts api.telegram.org) ---
TELEGRAM_SSL_INSECURE=true
# path to corporate CA PEM, or - to skip
TELEGRAM_CA_BUNDLE=-


# --- project id -> display NAME for the header ---
# SEED ONLY: on first start this map is imported into the DB `project` table;
# after that the DB wins and the catalog is edited in the web UI («Проекты»).
# Unknown projects auto-register there as events arrive.
# SENTRY_PROJECTS=2:configurator,3:s_billing,4:billing
# API fallback: auth token with project:read; empty disables the API lookup.
# The token also powers the Discover lookups (/req, /why, /activity) — add event:read.
SENTRY_API_TOKEN=
SENTRY_API_URL=http://web:9000
SENTRY_ORG=sentry

# --- Discover lookups (/req, /why, /activity) ---
# Where the user's msisdn lives in events: Sentry search keys tried in order
# (user.id / user.username / a custom tag name).
SENTRY_MSISDN_FIELDS=user.id,user.username,msisdn
# Where the request id lives: a tag name, or 'trace' for the distributed trace id.
SENTRY_REQUEST_ID_FIELDS=request_id,trace
# Where the device id lives (web investigation form at /web/).
SENTRY_DEVICE_ID_FIELDS=deviceId,device_id
# Environment choices the web form offers (must match Sentry environment names).
WEB_ENVIRONMENTS=prod,stage
# Times users type in /why are local; Sentry stores UTC. Offset in hours.
TIMEZONE_OFFSET_HOURS=6
# Sentry Logs dataset: user ACTIONS (incl. successful ones) for /activity, /why.
# Empty disables. Some services set the msisdn attribute, others only mention it
# in the message text — the default template covers both ({value} = the msisdn).
SENTRY_LOGS_DATASET=logs
SENTRY_LOGS_MSISDN_QUERY=(msisdn:"{value}" OR message:"{value}")
# Project scope of all Discover searches: -1 = all projects (recommended —
# without it Sentry narrows to the token's member projects). Or ids: 2,3,6
SENTRY_SEARCH_PROJECTS=-1
# Environments to search, comma-separated. Empty = ALL (prod, stage, dev, ...).
# Set e.g. "prod" to ignore stage/dev noise.
SENTRY_ENVIRONMENTS=

# --- project id -> GitLab REPO (feeds the LLM the real code around the crash) ---
# GITLAB_PROJECTS is a SEED like SENTRY_PROJECTS: imported into the DB once,
# then the repo links are attached per project in the web UI («Проекты»).
# Value: the GitLab project's full namespace path or numeric id.
# URL + TOKEN still come from env.
# GITLAB_URL=https://gitlab.beeline.kg
# GITLAB_TOKEN=
# GITLAB_PROJECTS=2:billingapi/configurator-service,3:billingapi/billing-service
# GITLAB_REF=main
# GITLAB_CONTEXT_LINES=25

# --- corporate HTTP proxy (runtime) ---
HTTP_PROXY=http://10.16.195.94:8080
HTTPS_PROXY=http://10.16.195.94:8080
http_proxy=http://10.16.195.94:8080
https_proxy=http://10.16.195.94:8080
