# Copy to .env next to docker-compose.yml and fill in. .env is gitignored — never commit it.
# docker-compose.yml loads this whole file via `env_file`.

# --- required ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-100xxxxxxxxxx:8        # "chatid:thread" to post into a forum topic
SENTRY_CLIENT_SECRET=                    # Internal Integration Client Secret (empty = signature check off)

# --- app ---
DB_PATH=data/state.db
ENABLE_LLM=false
ANTHROPIC_API_KEY=-
ANTHROPIC_MODEL=-
LOG_RAW_PAYLOAD=false                    # true to dump raw Sentry payloads to the log

# --- Telegram TLS (corporate proxy intercepts api.telegram.org) ---
TELEGRAM_SSL_INSECURE=true
TELEGRAM_CA_BUNDLE=-                      # path to corporate CA PEM, or - to skip

# --- Sentry API: resolve numeric project id -> name ---
SENTRY_API_TOKEN=                        # auth token with project:read; empty disables the lookup
SENTRY_API_URL=http://web:9000           # internal Sentry service on the shared docker network
SENTRY_ORG=sentry

# --- corporate HTTP proxy (runtime) ---
HTTP_PROXY=http://10.16.195.94:8080
HTTPS_PROXY=http://10.16.195.94:8080
http_proxy=http://10.16.195.94:8080
https_proxy=http://10.16.195.94:8080
