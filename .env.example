# Copy to .env next to docker-compose.yml and fill in. .env is gitignored — never commit it.
# docker-compose.yml loads this whole file via `env_file`.
# IMPORTANT: no inline comments — put comments on their own line. With env_file,
# anything after `=` (including "# ...") becomes part of the value.

# --- required ---
TELEGRAM_BOT_TOKEN=
# There is NO default chat. Alerts are opt-in per chat: add the bot to a chat/topic
# and run /subscribe <project|all> there. See the README "Subscriptions" section.
# Internal Integration Client Secret (leave empty to disable the signature check)
SENTRY_CLIENT_SECRET=

# --- app ---
DB_PATH=data/state.db
# The three occurrence counts shown on line 2, e.g. 2343/43/22 (12h/6h/10m).
# Counted from our own event_log. Values in MINUTES: "720,360,10" = 12h/6h/10m.
STAT_WINDOWS=720,360,10

# NOTE: the values below are DEFAULTS. Any chat can override its own trigger rules,
# statuses and stat windows at runtime with /set and /alerts (see README, /help).
# Subscriptions are per chat and opt-in: /subscribe <project|all>, /alerts, /params.

# --- alert triggers ---
# ongoing reminder: min gap (hours) between alerts for the same issue
WINDOW_INTERVAL_FROM_LAST_ALERT_IN_HOUR=12
# critical: within this window (minutes), > THRESHOLD errors OR >= USERS distinct users
WINDOW_CRITICAL_INTERVAL_IN_MINUTE=10
CRITICAL_ERROR_THRESHOLD=15
AFFECTED_USER_THRESHOLD=5
# critical alerts are rate-limited to once per this many hours
WINDOW_INTERVAL_FOR_CRITICAL_IN_HOUR=4

# --- keywords (force-send) ---
# keyword force-send anti-spam floor (seconds per issue); 0 = send every match
KEYWORD_MIN_INTERVAL_SEC=0
# LLM cause+fix + /ask agent (Claude Agent SDK). Off by default.
ENABLE_LLM=false
# Auth: EITHER an Anthropic API key ...
ANTHROPIC_API_KEY=
# ... OR a Claude subscription OAuth token (Pro/Max) from `claude setup-token`,
# valid ~1 year. If both are set, the API key wins.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-4-8
# hard ceiling on the LLM reply length (cap, not target; billed per token generated)
ANTHROPIC_MAX_TOKENS=1024
# price per 1M tokens for the cost line in the message (default = Opus 4.8 $5/$25)
ANTHROPIC_PRICE_IN=5.0
ANTHROPIC_PRICE_OUT=25.0
# USD -> Kyrgyz som (KGS), to also show cost in сом
USD_KGS_RATE=89.5

# --- agent (/ask, /ai, POST /ask) ---
# Каждый запуск агента — это цикл вызовов инструментов (Sentry + GitLab); лимиты
# на один запуск. Analysis-* — для авто-анализа алертов (webhook path, жёстче).
AGENT_MAX_TURNS=12
AGENT_MAX_BUDGET_USD=1.0
# /ai — полный путь расследования (event -> trace -> действия юзера -> код -> blame),
# длиннее обычного /ask
INVESTIGATE_MAX_TURNS=18
INVESTIGATE_MAX_BUDGET_USD=1.5
ANALYSIS_MAX_TURNS=5
ANALYSIS_MAX_BUDGET_USD=0.30
# сколько агентов может работать одновременно (каждый — отдельный подпроцесс)
AGENT_MAX_CONCURRENCY=2
# ключ для HTTP POST /ask (заголовок x-api-key); пусто = эндпоинт выключен
ASK_API_KEY=
# CA бандл для Anthropic (корп. прокси MITM-ит api.anthropic.com); также
# прокидывается подпроцессу агента как NODE_EXTRA_CA_CERTS / SSL_CERT_FILE.
# ANTHROPIC_CA_BUNDLE=/etc/ssl/corp-ca.pem
# ANTHROPIC_SSL_INSECURE=true
# true to dump raw Sentry payloads to the log
LOG_RAW_PAYLOAD=false

# --- Telegram TLS (corporate proxy intercepts api.telegram.org) ---
TELEGRAM_SSL_INSECURE=true
# path to corporate CA PEM, or - to skip
TELEGRAM_CA_BUNDLE=-

# --- project id -> display NAME for the header ---
# Static map, checked first (no token needed). Get the numeric id from an alert:
# when unresolved the header shows the id itself, e.g. "3 · prod · ongoing".
# SENTRY_PROJECTS=2:configurator,3:s_billing,4:billing
# API fallback: auth token with project:read; empty disables the API lookup.
SENTRY_API_TOKEN=
SENTRY_API_URL=http://web:9000
SENTRY_ORG=sentry

# --- project id -> GitLab REPO (feeds the LLM the real code around the crash) ---
# Separate map from SENTRY_PROJECTS above: same ids, but the value is the GitLab
# project's full namespace path (or numeric id). All of URL/TOKEN/PROJECTS needed.
# GITLAB_URL=https://gitlab.beeline.kg
# GITLAB_TOKEN=
# GITLAB_PROJECTS=2:billingapi/configurator-service,3:billingapi/billing-service
# GITLAB_REF=main
# GITLAB_CONTEXT_LINES=25

# --- corporate HTTP proxy (runtime) ---
HTTP_PROXY=http://10.16.195.94:8080
HTTPS_PROXY=http://10.16.195.94:8080
http_proxy=http://10.16.195.94:8080
https_proxy=http://10.16.195.94:8080
