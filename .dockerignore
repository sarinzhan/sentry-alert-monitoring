# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# Secrets & local config (pass via -e / --env-file at run time)
.env

# Runtime state (SQLite debounce db)
state.db
*.db
*.db-journal
*.db-wal

# Web UI: runs as its own container (web-ui/Dockerfile) — nothing of it
# belongs in the app image
app/web/
web-ui/
**/node_modules
testops-ui/
stage-tests/

# VCS / editor / OS cruft
.git/
.gitignore
.idea/
.vscode/
.DS_Store

# Docs and unit file aren't needed in the image
README.md
sentry-telegram.service
